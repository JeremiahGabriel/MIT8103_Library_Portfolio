        <mxCell id="294" edge="1" parent="1" source="staff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;strokeColor=#333333;strokeWidth=1.5;fontSize=10;fontStyle=2;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" target="loan" value="issues">
